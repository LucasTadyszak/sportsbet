// Prisma schema for the SportsBet MVP: live odds board fed by The Odds API.
// https://the-odds-api.com/liveapi/guides/v4/

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A sport/competition as exposed by The Odds API (e.g. "soccer_epl", "basketball_nba").
model Sport {
  key    String  @id // Odds API sport_key
  group  String // e.g. "Soccer", "Basketball"
  title  String
  active Boolean @default(true)

  events Event[]

  @@map("sports")
}

// A single fixture/match.
model Event {
  id           String   @id // Odds API event id
  sportKey     String
  sport        Sport    @relation(fields: [sportKey], references: [key])
  commenceTime DateTime
  homeTeam     String
  awayTeam     String
  updatedAt    DateTime @updatedAt

  odds       Odds[]
  prediction MatchPrediction?

  @@index([sportKey, commenceTime])
  @@map("events")
}

// Registry of every team name The Odds API has ever reported. A team's name
// doesn't change sync to sync, so this is written once and kept forever
// instead of only living as a duplicated string on each Event — and it
// doubles as a persistent cache of the football-data.org match found for
// it, so that fuzzy name-matching only has to succeed once per team, not
// on every stats refresh.
model Team {
  id                 String   @id @default(cuid())
  name               String   @unique // exact team name as reported by The Odds API
  competitionCode    String? // football-data.org competition code, once matched
  footballDataTeamId Int? // football-data.org team id, once matched
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt

  @@map("teams")
}

// A bookmaker as exposed by The Odds API (e.g. "pinnacle", "bet365").
model Bookmaker {
  key   String @id
  title String

  odds Odds[]

  @@map("bookmakers")
}

// One captured price for one outcome of one market, from one bookmaker, for one event.
// A row is written on every sync (not only when the price moves), so the table is
// a complete history of every observation, not just a log of changes.
model Odds {
  id           BigInt    @id @default(autoincrement())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  bookmakerKey String
  bookmaker    Bookmaker @relation(fields: [bookmakerKey], references: [key])
  marketKey    String // "h2h" | "spreads" | "totals"
  outcomeName  String // team name, or "Over" / "Under"
  price        Float // decimal odds
  point        Float? // spread/total line, null for h2h
  lastUpdate   DateTime // bookmaker-reported timestamp from the API payload
  capturedAt   DateTime  @default(now())

  @@index([eventId, marketKey, bookmakerKey])
  @@map("odds")
}

// Tracks The Odds API's own usage headers so we never blow through the plan's quota.
model ApiUsageLog {
  id                BigInt   @id @default(autoincrement())
  provider          String // "the-odds-api"
  endpoint          String
  requestsUsed      Int?
  requestsRemaining Int?
  requestsLastCost  Int?
  capturedAt        DateTime @default(now())

  @@map("api_usage_log")
}

// Throttling guard: last successful fetch per resource key, so a refresh route
// can no-op if it ran recently instead of spending API credits.
model FetchLog {
  resourceKey   String   @id // e.g. "odds:soccer_epl"
  lastFetchedAt DateTime @default(now())

  @@map("fetch_log")
}

// Season standings for one team in one competition, as exposed by
// football-data.org (https://www.football-data.org/documentation/api). Used
// as the statistical base for the Poisson probability model below.
model TeamStats {
  id              String   @id @default(cuid())
  competitionCode String // football-data.org competition code, e.g. "PL", "CL"
  teamId          Int // football-data.org team id
  name            String // full name, e.g. "Manchester City FC"
  shortName       String?
  tla             String? // three-letter abbreviation, e.g. "MCI"
  position        Int?
  playedGames     Int
  won             Int
  draw            Int
  lost            Int
  points          Int
  goalsFor        Int
  goalsAgainst    Int
  form            String? // comma-separated recent results, e.g. "W,W,D,L,W"
  season          Int // competition season start year
  updatedAt       DateTime @updatedAt

  @@unique([competitionCode, teamId])
  @@index([competitionCode, name])
  @@map("team_stats")
}

// Model-estimated outcome probabilities for one event, derived from
// TeamStats via a Poisson goals model. Recomputed whenever fresher stats
// or a fresher event come in; not a betting recommendation, informational only.
model MatchPrediction {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  event              Event    @relation(fields: [eventId], references: [id])
  homeWinProbability Float
  drawProbability    Float
  awayWinProbability Float
  expectedHomeGoals  Float
  expectedAwayGoals  Float
  modelVersion       String   @default("poisson-v1")
  computedAt         DateTime @default(now())

  @@map("match_predictions")
}
