// Prisma schema for the SportsBet MVP: live odds board fed by The Odds API.
// https://the-odds-api.com/liveapi/guides/v4/

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A sport/competition as exposed by The Odds API (e.g. "soccer_epl", "basketball_nba").
model Sport {
  key           String    @id // Odds API sport_key
  group         String // e.g. "Soccer", "Basketball"
  title         String
  active        Boolean   @default(true)
  // Competition logo from TheSportsDB (src/lib/refreshLogos.ts), e.g. the Premier League lion.
  logo          String?
  logoCheckedAt DateTime? // last lookup, found or not: when it's next due

  events Event[]

  @@map("sports")
}

// A single fixture/match.
model Event {
  id           String   @id // Odds API event id
  sportKey     String
  sport        Sport    @relation(fields: [sportKey], references: [key])
  commenceTime DateTime
  homeTeam     String
  awayTeam     String
  updatedAt    DateTime @updatedAt

  odds       Odds[]
  prediction MatchPrediction?
  edges      Edge[]
  picks      Pick[]
  grade      EventGrade?

  @@index([sportKey, commenceTime])
  @@map("events")
}

// Registry of every team name The Odds API has ever reported. A team's name
// doesn't change sync to sync, so this is written once and kept forever
// instead of only living as a duplicated string on each Event — and it
// doubles as a persistent cache of the football-data.org match found for
// it, so that fuzzy name-matching only has to succeed once per team, not
// on every stats refresh.
model Team {
  id                 String    @id @default(cuid())
  name               String    @unique // exact team name as reported by The Odds API
  competitionCode    String? // football-data.org competition code, once matched
  footballDataTeamId Int? // football-data.org team id, once matched
  nationalTeamId     Int? // NationalTeam id, once matched (national-team competitions)
  // TheSportsDB team, once matched (src/lib/refreshLogos.ts) — set by hand to fix a team the
  // name matching never finds: its logo is then looked up by this id.
  sportsDbTeamId     String?
  logo               String? // club badge from TheSportsDB
  logoCheckedAt      DateTime? // last lookup, found or not: when it's next due
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @updatedAt

  @@map("teams")
}

// A men's national team, under its current name in the international results dataset
// (github.com/martj42/international_results). Its Elo rating is stored in TeamRating under
// the negative of this id, so it can never collide with a football-data.org club id.
model NationalTeam {
  id   Int    @id @default(autoincrement())
  name String @unique // e.g. "Republic of Ireland", "Czech Republic"

  homeMatches InternationalMatch[] @relation("homeTeam")
  awayMatches InternationalMatch[] @relation("awayTeam")

  @@map("national_teams")
}

// Every men's full international of the dataset, 1872 onwards. Feeds the national-team Elo
// and goals model, and grades picks on national-team events (90-minute score, like clubs).
model InternationalMatch {
  id         Int          @id @default(autoincrement())
  date       DateTime     @db.Date // local date of the match: the dataset has no kick-off time
  homeTeamId Int
  homeTeam   NationalTeam @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   NationalTeam @relation("awayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int // final score: extra time included, penalty shoot-out not
  awayScore  Int
  // Score after 90 minutes, only when the goal minutes make it certain (null: e.g. a late
  // goal that may have been extra time, or no scorer list yet).
  home90     Int?
  away90     Int?
  tournament String
  eloClass   String // WC | CC | WCQ | CQ | NL | FRIENDLY | OTHER — see internationalResultsApi.ts
  neutral    Boolean
  updatedAt  DateTime     @updatedAt

  @@unique([date, homeTeamId, awayTeamId])
  @@index([homeTeamId, date])
  @@index([awayTeamId, date])
  @@map("international_matches")
}

// A bookmaker as exposed by The Odds API (e.g. "pinnacle", "bet365").
model Bookmaker {
  key   String @id
  title String

  odds Odds[]

  @@map("bookmakers")
}

// One captured price for one outcome of one market, from one bookmaker, for one event.
// A row is written on every sync (not only when the price moves), so the table is
// a complete history of every observation, not just a log of changes.
model Odds {
  id           BigInt    @id @default(autoincrement())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  bookmakerKey String
  bookmaker    Bookmaker @relation(fields: [bookmakerKey], references: [key])
  marketKey    String // "h2h" | "spreads" | "totals"
  outcomeName  String // team name, or "Over" / "Under"
  price        Float // decimal odds
  point        Float? // spread/total line, null for h2h
  lastUpdate   DateTime // bookmaker-reported timestamp from the API payload
  capturedAt   DateTime  @default(now())

  @@index([eventId, marketKey, bookmakerKey])
  @@map("odds")
}

// One row per API call, with the usage headers it came back with, so we never blow
// through a plan's quota. For Free API Live Football Data the row is written before the
// call goes out: its last hour of rows is what the hourly cap counts (src/lib/liveFootballApi.ts).
model ApiUsageLog {
  id                BigInt   @id @default(autoincrement())
  provider          String // "the-odds-api" | "football-data.org" | "free-api-live-football-data"
  endpoint          String
  requestsUsed      Int?
  requestsRemaining Int?
  requestsLastCost  Int?
  capturedAt        DateTime @default(now())

  @@index([provider, capturedAt])
  @@map("api_usage_log")
}

// Throttling guard: last successful fetch per resource key, so a refresh route
// can no-op if it ran recently instead of spending API credits.
model FetchLog {
  resourceKey   String   @id // e.g. "odds:soccer_epl"
  lastFetchedAt DateTime @default(now())

  @@map("fetch_log")
}

// Season standings for one team in one competition, as exposed by
// football-data.org (https://www.football-data.org/documentation/api). Used
// as the statistical base for the Poisson probability model below.
model TeamStats {
  id              String   @id @default(cuid())
  competitionCode String // football-data.org competition code, e.g. "PL", "CL"
  teamId          Int // football-data.org team id
  name            String // full name, e.g. "Manchester City FC"
  shortName       String?
  tla             String? // three-letter abbreviation, e.g. "MCI"
  crest           String? // club crest URL, e.g. "https://crests.football-data.org/65.png"
  clubColors      String? // kit colours as football-data.org words them, e.g. "Red / White"
  position        Int?
  playedGames     Int
  won             Int
  draw            Int
  lost            Int
  points          Int
  goalsFor        Int
  goalsAgainst    Int
  form            String? // comma-separated recent results, e.g. "W,W,D,L,W"
  season          Int // competition season start year
  updatedAt       DateTime @updatedAt

  @@unique([competitionCode, teamId])
  @@index([competitionCode, name])
  @@map("team_stats")
}

// Model-estimated outcome probabilities for one event (the "raw" model, before
// any market anchor, line-movement nudge or calibration — see src/lib/methodology).
// homeWin/draw/awayWin is the Elo + goals-model blend; the two components are kept
// alongside so the match page can show where the number comes from. Recomputed
// whenever fresher stats or a fresher event come in, only while the match is upcoming.
model MatchPrediction {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  event              Event    @relation(fields: [eventId], references: [id])
  homeWinProbability Float
  drawProbability    Float
  awayWinProbability Float
  expectedHomeGoals  Float? // null when only the Elo side of the model could run
  expectedAwayGoals  Float?
  // Dixon-Coles low-score correlation used with the expected goals above to rebuild
  // the full score grid (and so any totals line) without storing it.
  rho                Float    @default(0)
  eloHomeRating      Float?
  eloAwayRating      Float?
  eloHomeWin         Float?
  eloDraw            Float?
  eloAwayWin         Float?
  goalsHomeWin       Float?
  goalsDraw          Float?
  goalsAwayWin       Float?
  // "full" | "partial" | "thin" — thin team data caps the verdict at MARGINAL.
  dataQuality        String   @default("partial")
  components         Json? // form/rest adjustments, sample sizes, which sub-models ran
  modelVersion       String   @default("poisson-v1")
  computedAt         DateTime @default(now())

  @@map("match_predictions")
}

// Every football-data.org match of a tracked competition (finished or not). The
// finished ones feed the Elo ratings, the goals model and the last-10 form score;
// they are also how picks get graded (90-minute score, like bookmakers settle).
model Fixture {
  id              Int      @id // football-data.org match id
  competitionCode String
  season          Int // season start year
  utcDate         DateTime
  status          String // SCHEDULED | TIMED | IN_PLAY | PAUSED | FINISHED | POSTPONED | CANCELLED | ...
  matchday        Int?
  stage           String?
  homeTeamId      Int
  awayTeamId      Int
  homeTeamName    String
  awayTeamName    String
  homeGoals       Int? // score after 90 minutes (regularTime when the match went to extra time)
  awayGoals       Int?
  updatedAt       DateTime @updatedAt

  @@index([competitionCode, utcDate])
  @@index([homeTeamId, utcDate])
  @@index([awayTeamId, utcDate])
  @@map("fixtures")
}

// Current Elo rating of a team (football-data.org team id), replayed from scratch
// over every stored finished Fixture on each stats refresh. National teams are rated
// separately, over every InternationalMatch, under the negative of their NationalTeam id.
model TeamRating {
  teamId       Int       @id
  name         String
  elo          Float
  matchesRated Int
  // Mean (actual - expected) Elo score over the last 10 matches: the hot/cold streak signal.
  formScore    Float     @default(0)
  lastMatchAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("team_ratings")
}

// Per-competition parameters: Elo constants tuned on that league's own history
// (K factor, home-field advantage, draw model) and the fitted Dixon-Coles goals model.
// National teams get one row per Elo class ("INT-NL", "INT-WCQ"…), all carrying the one
// goals model fitted on every recent international.
model CompetitionModel {
  competitionCode String   @id
  kFactor         Float
  homeAdvantage   Float // Elo points
  drawBase        Float // draw probability between two equal teams
  drawWidth       Float // how fast the draw probability decays with the Elo gap
  eloTuned        Boolean  @default(false) // false = defaults (not enough history to tune)
  goalsBase       Float? // goals-model baseline per team per match
  goalsHomeAdv    Float? // goals-model home multiplier
  rho             Float    @default(0)
  teamStrengths   Json? // { [teamId]: { attack, defense, games } }
  matchesUsed     Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("competition_models")
}

// Latest verdict for every outcome of every priced market of an upcoming event,
// rewritten wholesale after each odds refresh ("edges recomputed" loop). Purely a
// read model for the UI — the permanent record is Pick.
model Edge {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id])
  marketKey        String // "h2h" | "totals"
  outcomeName      String
  point            Float?
  bestPrice        Float?
  bestBookmakerKey String?
  marketProb       Float // Pinnacle-weighted consensus, de-vigged
  sharpProb        Float? // Pinnacle alone, de-vigged
  modelRawProb     Float // blend straight out of the model
  modelBaseProb    Float // after market anchor + line-movement nudge (pre-calibration)
  modelProb        Float // final: calibrated, clamped — what the edge is computed from
  edge             Float // modelProb - marketProb (probability points)
  ev               Float? // expected return per unit staked at bestPrice
  tier             String // HERO | STRONG_BET | BOSS_PICK | GOOD_BET | MARGINAL | PASS
  reasons          String[]
  signals          Json
  stakeUnits       Float    @default(0)
  isRecommended    Boolean  @default(false) // the side the model would take in this market
  computedAt       DateTime @default(now())

  @@index([eventId])
  @@index([tier, isRecommended])
  @@map("edges")
}

// The journal: a staked recommendation, snapshotted with every input the moment it
// is published and never edited afterwards except to add its closing line and result.
model Pick {
  id                 String    @id @default(cuid())
  eventId            String
  event              Event     @relation(fields: [eventId], references: [id])
  sportKey           String
  commenceTime       DateTime
  marketKey          String
  outcomeName        String
  point              Float?
  bookmakerKey       String
  price              Float
  tier               String
  modelProb          Float
  modelProbPreOffset Float // before the journal's calibration offsets — what those offsets are fitted against
  marketProb         Float
  sharpProb          Float?
  edge               Float
  ev                 Float
  stakeUnits         Float
  inputs             Json // full snapshot of every input that fed the verdict
  modelVersion       String
  publishedAt        DateTime  @default(now())
  // Closing line, captured once the match has kicked off.
  closingFairProb    Float?
  closingSource      String? // "pinnacle" | "consensus"
  clv                Float? // price * closingFairProb - 1: did we beat the close?
  // Result, once the match is finished.
  status             String    @default("pending") // pending | won | lost | push | half_won | half_lost | void
  profitUnits        Float?
  homeGoals          Int?
  awayGoals          Int?
  gradedAt           DateTime?

  @@unique([eventId, marketKey])
  @@index([status])
  @@index([sportKey, marketKey])
  @@index([publishedAt])
  @@map("picks")
}

// Graded outcome of every finished event we priced, with the model's and the
// market's closing probabilities side by side — the basis for Brier / log-loss /
// reliability on /modele and for fitting the calibration edge scale.
model EventGrade {
  eventId      String   @id
  event        Event    @relation(fields: [eventId], references: [id])
  sportKey     String
  commenceTime DateTime
  homeGoals    Int
  awayGoals    Int
  result       String // "H" | "D" | "A"
  modelHome    Float? // model after anchor + nudge, before calibration
  modelDraw    Float?
  modelAway    Float?
  finalHome    Float? // final calibrated model
  finalDraw    Float?
  finalAway    Float?
  marketHome   Float? // closing Pinnacle-weighted consensus
  marketDraw   Float?
  marketAway   Float?
  sharpHome    Float? // closing Pinnacle
  sharpDraw    Float?
  sharpAway    Float?
  totalsLine   Float?
  modelOver    Float?
  marketOver   Float?
  gradedAt     DateTime @default(now())

  @@index([sportKey, commenceTime])
  @@map("event_grades")
}

// Output of the nightly "reflect" job: calibration statistics per bucket and the
// correction actually applied to the next predictions (offset in probability
// points, or the edge scale for scope "edge_scale").
model CalibrationBucket {
  id           String   @id @default(cuid())
  scope        String // "sport" | "sport_market" | "tier" | "edge_scale"
  sportKey     String
  marketKey    String   @default("")
  tier         String   @default("")
  n            Int
  avgPredicted Float
  hitRate      Float
  gap          Float // hitRate - avgPredicted (negative = overconfident)
  applied      Float // offset (pp as a fraction) or edge scale actually used
  computedAt   DateTime @default(now())

  @@unique([scope, sportKey, marketKey, tier])
  @@map("calibration_buckets")
}
