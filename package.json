{
  "name": "sportsbet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio",
    "refresh:odds": "tsx scripts/refresh-odds.ts",
    "refresh:stats": "tsx scripts/refresh-stats.ts",
    "refresh:edges": "tsx scripts/refresh-edges.ts",
    "refresh:logos": "tsx scripts/refresh-logos.ts",
    "refresh:matches": "tsx scripts/refresh-live-matches.ts",
    "nightly": "tsx scripts/nightly.ts",
    "live-football": "tsx scripts/live-football.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "^4",
    "dotenv": "^18.0.4",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
